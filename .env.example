# Clave para usar la API (header x-api-key). Generá una larga y aleatoria.
API_KEY=cambiame-por-una-clave-larga

# Carpeta donde se guarda la sesión de WhatsApp y el historial.
# En Railway montá un Volume en /data (el Dockerfile ya usa /data por defecto).
DATA_DIR=./data

# (Opcional) URL que recibe un POST por cada mensaje entrante
WEBHOOK_URL=
# (Opcional) se manda en el header x-webhook-secret para validar el origen
WEBHOOK_SECRET=

# (Opcional) cuántos mensajes guardar por chat
MAX_MESSAGES_PER_CHAT=100

LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn

# ---------- Anti-baneo (todas opcionales; estos son los valores por defecto) ----------
# ANTIBAN_ENABLED=true
# Pausa aleatoria entre mensajes (ms) y extra si es alguien que nunca te escribió
# ANTIBAN_MIN_DELAY_MS=2000
# ANTIBAN_MAX_DELAY_MS=6000
# ANTIBAN_NEW_CHAT_EXTRA_MS=4000
# Límites de envío
# ANTIBAN_MAX_PER_MINUTE=8
# ANTIBAN_MAX_PER_HOUR=120
# ANTIBAN_MAX_PER_DAY=800
# ANTIBAN_MAX_NEW_CHATS_PER_DAY=20
# ANTIBAN_MAX_IDENTICAL_PER_HOUR=5
# Mostrar "escribiendo…" antes de cada mensaje
# ANTIBAN_TYPING=true
# Número NUEVO: activar calentamiento (20 msj el día 1, sube x1.8 por día, libre desde el día 8)
# ANTIBAN_WARMUP=false
# Horas locales en que se envía más lento, y zona horaria
# ANTIBAN_QUIET_HOURS=0-7
# ANTIBAN_TZ=America/Argentina/Buenos_Aires
