# Clave para usar la API (header x-api-key). Generá una larga y aleatoria.
API_KEY=cambiame-por-una-clave-larga

# Carpeta donde se guarda la sesión de WhatsApp y el historial.
# En Railway montá un Volume en /data (el Dockerfile ya usa /data por defecto).
DATA_DIR=./data

# (Opcional) URL que recibe un POST por cada mensaje entrante
WEBHOOK_URL=
# (Opcional) se manda en el header x-webhook-secret para validar el origen
WEBHOOK_SECRET=

# (Opcional) cuántos mensajes guardar por chat
MAX_MESSAGES_PER_CHAT=100

LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
